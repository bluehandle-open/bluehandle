<?xml version="1.0" encoding="utf-8"?>
<!-- 首页大连接按钮：connected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#3A2D17" />
            <stroke android:width="10dp" android:color="@color/bh_action_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/bh_action_surface" />
            <stroke android:width="10dp" android:color="@color/bh_action_border" />
        </shape>
    </item>
</selector>
