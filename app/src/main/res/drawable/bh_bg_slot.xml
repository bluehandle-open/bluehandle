<?xml version="1.0" encoding="utf-8"?>
<!-- 组合键空位，选中时主色描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bh_surface_raised" />
            <stroke android:width="1.5dp" android:color="@color/bh_primary" />
            <corners android:radius="@dimen/bh_radius_s" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/bh_border_dashed"
                android:dashWidth="4dp" android:dashGap="3dp" />
            <corners android:radius="@dimen/bh_radius_s" />
        </shape>
    </item>
</selector>
