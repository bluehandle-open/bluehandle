<?xml version="1.0" encoding="utf-8"?>
<!-- 手柄按钮：按下时提亮并主色描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bh_surface_selected" />
            <stroke android:width="1.5dp" android:color="@color/bh_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bh_surface" />
            <stroke android:width="1dp" android:color="@color/bh_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
