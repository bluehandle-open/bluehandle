<?xml version="1.0" encoding="utf-8"?>
<!-- 按键编辑页的键盘键，选中为主色实底 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bh_primary" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bh_surface_raised" />
            <stroke android:width="1dp" android:color="@color/bh_border" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bh_bg" />
            <stroke android:width="1dp" android:color="@color/bh_border" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
