<?xml version="1.0" encoding="utf-8"?>
<!-- 次级动作键（锁屏）：深橙底橙边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A2D17" />
            <stroke android:width="1dp" android:color="@color/bh_action" />
            <corners android:radius="@dimen/bh_radius_m" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bh_action_surface" />
            <stroke android:width="1dp" android:color="@color/bh_action_border" />
            <corners android:radius="@dimen/bh_radius_m" />
        </shape>
    </item>
</selector>
