<?xml version="1.0" encoding="utf-8"?>
<!-- 普通卡片 / 次要按钮：深色底 + 细边框，按下时提亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bh_surface_raised" />
            <stroke android:width="@dimen/bh_border" android:color="@color/bh_border" />
            <corners android:radius="@dimen/bh_radius_m" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bh_surface" />
            <stroke android:width="@dimen/bh_border" android:color="@color/bh_border" />
            <corners android:radius="@dimen/bh_radius_m" />
        </shape>
    </item>
</selector>
