<?xml version="1.0" encoding="utf-8"?>
<!-- 遥控器功能键：图标 + 名称 + 对应的电脑快捷键 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="64dp"
    android:layout_weight="1"
    android:background="@drawable/bh_bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/key_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            app:tint="@color/bh_text" />

        <TextView
            android:id="@+id/key_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/bh_text"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/key_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/bh_text_secondary"
        android:textSize="10sp" />
</LinearLayout>
