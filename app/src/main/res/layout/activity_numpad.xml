<?xml version="1.0" encoding="utf-8"?>
<!-- 遥控器 · 数字键。对应设计稿 TvNumpad 画板。数字键由代码填充 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bh_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <include layout="@layout/bh_page_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bh_bg_card"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <TextView
            style="@style/BhText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近发送"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_echo"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:ellipsize="start"
            android:gravity="center_vertical"
            android:letterSpacing="0.1"
            android:singleLine="true"
            android:textColor="@color/bh_text"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            style="@style/BhText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="每按一次立即发送到电脑，这里只做回显" />
    </LinearLayout>

    <!-- 占满剩余高度，行高由代码按可用高度计算，矮屏上按键自动变矮，回车键不会被挤出屏幕 -->
    <LinearLayout
        android:id="@+id/numpad_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/key_enter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bh_bg_primary"
        android:gravity="center"
        android:text="回车 Enter"
        android:textColor="@color/bh_on_primary"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
