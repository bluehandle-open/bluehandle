<?xml version="1.0" encoding="utf-8"?>
<!-- 游戏手柄 · 选择键位方案。对应设计稿 GamepadScheme 画板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bh_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/bh_page_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/bh_page_padding"
    android:paddingBottom="24dp">

    <include layout="@layout/bh_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/BhText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingMultiplier="1.3"
                android:text="手柄界面不变，只改变每个按钮发给电脑的键。上次使用的方案会自动选中。"
                android:textSize="13sp" />

            <TextView style="@style/BhText.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="内置" />

            <include android:id="@+id/scheme_default" layout="@layout/bh_item_scheme" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView style="@style/BhText.Section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="我的方案" />

                <TextView
                    android:id="@+id/scheme_count"
                    style="@style/BhText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scheme_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btn_new_scheme"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/bh_gap"
                android:background="@drawable/bh_bg_dashed"
                android:gravity="center"
                android:text="＋ 新建方案"
                android:textColor="@color/bh_primary_text"
                android:textSize="15sp" />

            <TextView
                style="@style/BhText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="4dp"
                android:text="长按方案可删除" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btn_open_gamepad"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bh_bg_primary"
        android:gravity="center"
        android:textColor="@color/bh_on_primary"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
