<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页。对应设计稿 Settings 画板 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bh_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/bh_page_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/bh_page_padding"
        android:paddingBottom="32dp">

        <include layout="@layout/bh_page_header" />

        <!-- 连接 -->
        <TextView style="@style/BhText.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="连接" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bh_bg_group"
            android:divider="@drawable/bh_divider"
            android:orientation="vertical"
            android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="默认连接方式"
                    android:textColor="@color/bh_text"
                    android:textSize="@dimen/bh_text_body" />

                <LinearLayout
                    android:id="@+id/seg_default_type"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bh_bg_segment"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Wi‑Fi" android:textSize="14sp" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="蓝牙" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <include android:id="@+id/row_port" layout="@layout/bh_row_value" />
            <include android:id="@+id/row_network" layout="@layout/bh_row_value" />
        </LinearLayout>

        <!-- 反馈 -->
        <TextView style="@style/BhText.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="反馈" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bh_bg_group"
            android:divider="@drawable/bh_divider"
            android:orientation="vertical"
            android:showDividers="middle">

            <include android:id="@+id/row_shake" layout="@layout/bh_row_switch" />
            <include android:id="@+id/row_keep_screen" layout="@layout/bh_row_switch" />
        </LinearLayout>

        <!-- 游戏手柄 -->
        <TextView style="@style/BhText.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="游戏手柄" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bh_bg_group"
            android:divider="@drawable/bh_divider"
            android:orientation="vertical"
            android:showDividers="middle">

            <include android:id="@+id/row_gravity" layout="@layout/bh_row_switch" />

            <LinearLayout
                android:id="@+id/block_sensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sensitivity_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="倾斜灵敏度"
                        android:textColor="@color/bh_text"
                        android:textSize="@dimen/bh_text_body" />

                    <TextView
                        android:id="@+id/sensitivity_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/bh_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="倾斜灵敏度"
                    android:stepSize="1"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/bh_primary"
                    app:trackColorActive="@color/bh_primary"
                    app:trackColorInactive="@color/bh_border" />
            </LinearLayout>
        </LinearLayout>

        <!-- PPT 演示 -->
        <TextView style="@style/BhText.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="PPT 演示" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bh_bg_group"
            android:divider="@drawable/bh_divider"
            android:orientation="vertical"
            android:showDividers="middle">

            <include android:id="@+id/row_ppt_volume" layout="@layout/bh_row_switch" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="目标演讲时长"
                    android:textColor="@color/bh_text"
                    android:textSize="@dimen/bh_text_body" />

                <ImageButton
                    android:id="@+id/btn_minutes_minus"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bh_bg_small_button"
                    android:contentDescription="减少 5 分钟"
                    android:scaleType="center"
                    app:srcCompat="@drawable/bh_ic_minus"
                    app:tint="@color/bh_text" />

                <TextView
                    android:id="@+id/tv_minutes"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/bh_text"
                    android:textSize="@dimen/bh_text_body" />

                <ImageButton
                    android:id="@+id/btn_minutes_plus"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bh_bg_small_button"
                    android:contentDescription="增加 5 分钟"
                    android:scaleType="center"
                    app:srcCompat="@drawable/bh_ic_plus"
                    app:tint="@color/bh_text" />
            </LinearLayout>

            <include android:id="@+id/row_ppt_remind" layout="@layout/bh_row_switch" />
        </LinearLayout>

        <!-- 语音输入 -->
        <TextView style="@style/BhText.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="语音输入" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bh_bg_group"
            android:divider="@drawable/bh_divider"
            android:orientation="vertical"
            android:showDividers="middle">

            <include android:id="@+id/row_voice_lang" layout="@layout/bh_row_value" />
            <include android:id="@+id/row_voice_engine" layout="@layout/bh_row_value" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="发送到电脑后默认"
                    android:textColor="@color/bh_text"
                    android:textSize="@dimen/bh_text_body" />

                <LinearLayout
                    android:id="@+id/seg_voice_send"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bh_bg_segment"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="只输入文字" android:textSize="14sp" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="输入并回车" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 游戏手柄键位 -->
        <TextView style="@style/BhText.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="游戏手柄键位" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bh_bg_group"
            android:orientation="vertical">

            <include android:id="@+id/row_schemes" layout="@layout/bh_row_value" />
        </LinearLayout>

        <!-- 帮助与关于 -->
        <TextView style="@style/BhText.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="帮助与关于" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bh_bg_group"
            android:divider="@drawable/bh_divider"
            android:orientation="vertical"
            android:showDividers="middle">

            <include android:id="@+id/row_help" layout="@layout/bh_row_value" />
            <include android:id="@+id/row_download" layout="@layout/bh_row_value" />
            <include android:id="@+id/row_about" layout="@layout/bh_row_value" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
