<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView style="@style/BhGuide.Title" android:text="把手机和电脑连起来" />

    <TextView style="@style/BhGuide.Desc" android:text="Wi‑Fi 连接时，是电脑去连手机。" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bh_guide_num"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="1"
                android:textColor="@color/bh_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手机和电脑连同一个 Wi‑Fi"
                    android:textColor="@color/bh_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/BhText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="在同一个路由器下就行"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bh_guide_num"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="2"
                android:textColor="@color/bh_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手机首页点「开始连接」"
                    android:textColor="@color/bh_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bh_bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bh_guide_dot_wait" />

                    <TextView
                        style="@style/BhText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="等待电脑连接 · "
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_guide_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bh_guide_ip"
                        android:fontFamily="monospace"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:textColor="@color/bh_primary_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bh_guide_num"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="3"
                android:textColor="@color/bh_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="在电脑端输入这个地址，点「连接手机」"
                    android:textColor="@color/bh_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/BhText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="手机显示“已连接”就成功了"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <TextView
        style="@style/BhText.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="没有 Wi‑Fi 也可以在首页切换到蓝牙连接。" />
</LinearLayout>
