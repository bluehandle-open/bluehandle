<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView style="@style/BhGuide.Title" android:text="@string/ui_connect_your_phone_and_computer" />

    <TextView style="@style/BhGuide.Desc" android:text="@string/ui_with_wi_fi_the_computer_connects_to_your_phone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bh_guide_num"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="1"
                android:textColor="@color/bh_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_connect_both_devices_to_the_same_wi_fi"
                    android:textColor="@color/bh_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/BhText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/ui_both_devices_must_use_the_same_router"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bh_guide_num"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="2"
                android:textColor="@color/bh_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_tap_start_connection_on_your_phone_s_home_screen"
                    android:textColor="@color/bh_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bh_bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bh_guide_dot_wait" />

                    <TextView
                        style="@style/BhText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/ui_waiting_address_prefix"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_guide_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bh_guide_ip"
                        android:fontFamily="monospace"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:textColor="@color/bh_primary_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bh_guide_num"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="3"
                android:textColor="@color/bh_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_enter_this_address_in_the_desktop_app_and_click_connect_to_phone"
                    android:textColor="@color/bh_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/BhText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/ui_your_phone_will_show_connected_when_ready"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <TextView
        style="@style/BhText.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_you_can_also_switch_to_bluetooth_on_the_home_screen" />
</LinearLayout>
