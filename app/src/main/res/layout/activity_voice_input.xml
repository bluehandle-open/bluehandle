<?xml version="1.0" encoding="utf-8"?>
<!-- 遥控器 · 语音输入。对应设计稿 TvVoice 画板。
     内置识别时显示大麦克风；使用系统输入法时隐藏麦克风区，由输入法的语音按钮输入 -->
<!-- 外层可滚动：小屏手机弹出软键盘后剩余高度不够，内容可以上下滚动而不是被裁掉 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bh_bg"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="@dimen/bh_touch_min"
            android:layout_height="@dimen/bh_touch_min"
            android:background="@drawable/bh_bg_card"
            android:contentDescription="@string/ui_close_voice_input"
            android:scaleType="center"
            app:srcCompat="@drawable/bh_ic_close"
            app:tint="@color/bh_text" />

        <TextView
            style="@style/BhText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/ui_voice_input" />

        <TextView
            android:id="@+id/btn_language"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bh_bg_card"
            android:gravity="center"
            android:minWidth="@dimen/bh_touch_min"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/bh_text"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 识别结果 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bh_bg_card"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_result_label"
                style="@style/BhText.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@+id/et_text"
                android:text="@string/ui_recognition_result_tap_to_edit" />

            <ImageButton
                android:id="@+id/btn_clear"
                android:layout_width="@dimen/bh_touch_min"
                android:layout_height="@dimen/bh_touch_min"
                android:background="@drawable/bh_bg_row"
                android:contentDescription="@string/ui_clear_recognition_result"
                android:scaleType="center"
                app:srcCompat="@drawable/bh_ic_trash"
                app:tint="@color/bh_text_secondary" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:hint="@string/ui_speak_or_type_to_enter_text_at_your_computer_s_cursor"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLines="6"
            android:minLines="2"
            android:textColor="@color/bh_text"
            android:textColorHint="@color/bh_text_secondary"
            android:textCursorDrawable="@null"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- 内置识别：麦克风区。wrap_content + weight：屏幕够高时占满剩余空间，不够时保持自身高度并让页面滚动 -->
    <LinearLayout
        android:id="@+id/block_mic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="184dp"
            android:layout_height="184dp">

            <View
                android:id="@+id/mic_halo_outer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bh_bg_mic_halo_outer" />

            <View
                android:id="@+id/mic_halo_inner"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/bh_bg_mic_halo_inner" />

            <FrameLayout
                android:id="@+id/btn_mic"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:background="@drawable/bh_bg_mic"
                android:clickable="true"
                android:contentDescription="@string/ui_start_speaking"
                android:focusable="true">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/bh_ic_mic"
                    app:tint="@color/bh_on_primary" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/wave"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tv_mic_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/bh_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_mic_hint"
            style="@style/BhText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/ui_slide_up_to_cancel_tap_to_start_and_stop_automatically_after_a_pa" />
    </LinearLayout>

    <!-- 系统输入法：提示 -->
    <TextView
        android:id="@+id/tv_ime_hint"
        style="@style/BhText.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:text="@string/ui_tap_the_microphone_on_your_keyboard_to_speak_nyou_can_also_type_d"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

    <TextView
        style="@style/BhText.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="@string/ui_after_sending" />

    <LinearLayout
        android:id="@+id/seg_send_mode"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_weight="1"
        android:background="@drawable/bh_bg_segment"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/ui_text_only" android:textSize="14sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/ui_text_and_enter" android:textSize="14sp" />
    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_retry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bh_bg_card"
            android:gravity="center"
            android:text="@string/ui_try_again"
            android:textColor="@color/bh_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_send"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="2"
            android:background="@drawable/bh_bg_action"
            android:gravity="center"
            android:text="@string/ui_send_to_computer"
            android:textColor="@color/bh_on_action"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
