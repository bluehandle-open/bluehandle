<?xml version="1.0" encoding="utf-8"?>
<!-- 首页：连接 + 选择模式。对应设计稿 Main 画板 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bh_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/bh_page_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/bh_page_padding"
        android:paddingBottom="24dp">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bh_bg_logo">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/bh_ic_gamepad"
                    app:tint="@color/bh_on_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/bh_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="@dimen/bh_touch_min"
                android:layout_height="@dimen/bh_touch_min"
                android:background="@drawable/bh_bg_card"
                android:contentDescription="设置"
                android:scaleType="center"
                app:srcCompat="@drawable/bh_ic_settings"
                app:tint="@color/bh_text" />
        </LinearLayout>

        <!-- 连接卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bh_bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/seg_connect_type"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bh_bg_segment"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/seg_wifi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Wi‑Fi"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/seg_bluetooth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="蓝牙"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_connect"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bh_bg_connect_idle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btn_connect_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/bh_ic_power"
                    app:tint="@color/bh_on_primary" />

                <TextView
                    android:id="@+id/btn_connect_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="开始连接"
                    android:textColor="@color/bh_on_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bh_dot" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/bh_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_detail"
                style="@style/BhText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="遥控模式"
            android:textColor="@color/bh_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/mode_gamepad"
            layout="@layout/bh_item_mode" />

        <include
            android:id="@+id/mode_remote"
            layout="@layout/bh_item_mode" />

        <include
            android:id="@+id/mode_ppt"
            layout="@layout/bh_item_mode" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_download"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bh_bg_card"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="下载电脑端"
                android:textColor="@color/bh_text"
                android:textSize="14sp" />

            <Space
                android:layout_width="@dimen/bh_gap"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/btn_help"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bh_bg_card"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="使用帮助"
                android:textColor="@color/bh_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
