<?xml version="1.0" encoding="utf-8"?>
<!-- 首页模式卡片：图标 + 名称/角标 + 场景说明 + 箭头 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/bh_gap"
    android:background="@drawable/bh_bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bh_bg_icon_box">

        <ImageView
            android:id="@+id/mode_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/bh_primary_text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mode_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bh_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mode_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bh_bg_badge"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="新"
                android:textColor="@color/bh_on_action"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/mode_desc"
            style="@style/BhText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/bh_ic_chevron_right"
        app:tint="@color/bh_text_secondary" />
</LinearLayout>
