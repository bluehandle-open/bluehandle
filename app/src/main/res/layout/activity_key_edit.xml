<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义键位方案编辑。对应设计稿 KeyEdit 画板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bh_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/bh_page_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/bh_page_padding">

    <include layout="@layout/bh_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@+id/et_scheme_name"
                android:text="方案名称"
                android:textColor="@color/bh_text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_scheme_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bh_bg_card"
                android:hint="例如：赛车游戏"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="20"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/bh_text"
                android:textColorHint="@color/bh_text_secondary"
                android:textSize="15sp" />

            <!-- 正在编辑的按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bh_bg_card_selected"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_edit_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/bh_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bh_bg_small_button"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="清空"
                        android:textColor="@color/bh_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/slot_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bh_bg_slot" android:gravity="center" android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="+" android:textColor="@color/bh_text_secondary" android:textSize="16sp" />
                    <TextView android:id="@+id/slot_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bh_bg_slot" android:gravity="center" android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="+" android:textColor="@color/bh_text_secondary" android:textSize="16sp" />
                    <TextView android:id="@+id/slot_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bh_bg_slot" android:gravity="center" android:textSize="16sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/key_categories"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/key_board"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="按键映射"
                android:textColor="@color/bh_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/mapping_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
