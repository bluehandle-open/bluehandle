<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 改版后所有界面使用的主题。浅色 / 深色由夜间模式决定（设置里的“外观”），
         颜色取自 values/ 与 values-night/ 下的 colors_bh.xml -->
    <style name="Theme.BlueHandle" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bh_primary</item>
        <item name="colorPrimaryVariant">@color/bh_bg</item>
        <item name="colorOnPrimary">@color/bh_on_primary</item>
        <item name="colorSecondary">@color/bh_action</item>
        <item name="colorSecondaryVariant">@color/bh_action</item>
        <item name="colorOnSecondary">@color/bh_on_action</item>
        <item name="colorSurface">@color/bh_surface</item>
        <item name="colorOnSurface">@color/bh_text</item>
        <item name="colorControlNormal">@color/bh_text_secondary</item>
        <item name="colorControlActivated">@color/bh_primary</item>
        <item name="android:colorBackground">@color/bh_bg</item>
        <item name="android:windowBackground">@color/bh_bg</item>
        <item name="android:textColorPrimary">@color/bh_text</item>
        <item name="android:textColorSecondary">@color/bh_text_secondary</item>
        <item name="android:statusBarColor" tools:targetApi="lollipop">@color/bh_status_bar</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@color/bh_nav_bar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/bh_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/bh_light_bars</item>
    </style>

    <!-- 横屏手柄：全屏 -->
    <style name="Theme.BlueHandle.Fullscreen">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- 页面标题 -->
    <style name="BhText.Title" parent="">
        <item name="android:textColor">@color/bh_text</item>
        <item name="android:textSize">@dimen/bh_text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 分组标题 -->
    <style name="BhText.Section" parent="">
        <item name="android:textColor">@color/bh_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">10dp</item>
    </style>

    <style name="BhText.Caption" parent="">
        <item name="android:textColor">@color/bh_text_secondary</item>
        <item name="android:textSize">@dimen/bh_text_caption</item>
    </style>

    <!-- 新用户引导的页标题与说明 -->
    <style name="BhGuide.Title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/bh_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="BhGuide.Desc" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bh_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>
</resources>
